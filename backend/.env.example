# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dumps_db

# Local storage path for photos & thumbnails
STORAGE_PATH=./storage

# ML Clustering Parameters
DBSCAN_EPS=0.35
DBSCAN_MIN_SAMPLES=3
RESCUE_THRESHOLD=0.45

# Server
HOST=0.0.0.0
PORT=8000

# Cloudflare R2 / S3 Object Storage
R2_ACCESS_KEY_ID=<your_r2_access_key_id>
R2_SECRET_ACCESS_KEY=<your_r2_secret_access_key>
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=dumps-photos
